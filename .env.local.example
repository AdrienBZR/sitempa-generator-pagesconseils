# Copy this file to .env.local (which is gitignored) and paste your secret.
#
#   cp .env.local.example .env.local
#
# GOOGLE_CREDENTIALS_JSON : same value as in Coolify (base64 of the service
# account JSON). Reveal it in Coolify with the eye icon and paste it below,
# wrapped in single quotes. Never commit .env.local.

GOOGLE_CREDENTIALS_JSON='XXXX'

# CRAWL_PROXY_URL (optional): route the prod-sitemap crawl through a residential
# proxy / unlocker when the datacenter IP is flagged by Cloudflare. Unset = the
# crawl goes out directly. Example (Bright Data):
#   CRAWL_PROXY_URL='http://brd-customer-<id>-zone-<zone>:<pass>@brd.superproxy.io:33335'
# CRAWL_PROXY_INSECURE=1 disables TLS verification if the unlocker uses its own CA.
# CRAWL_PROXY_URL=''
